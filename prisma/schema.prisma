generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Message {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  projectType String?
  message     String
  status      String   @default("unread")
  createdAt   DateTime @default(now())
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String
  description String
  image       String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}